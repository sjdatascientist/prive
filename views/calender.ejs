<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- <script src="../dist/datera.min.js"></script> -->
    <!-- <link rel="stylesheet" href="../dist/datera.min.css" /> -->
    <!-- <title>Document</title> -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
</head>
<body>
    <form action="">
        <input id="myID" type="datetime-local" placeholder="select datetime">
    </form>

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        flatpickr("#myID", {
            dateFormat: "d-m-y",
            mode: "range"
        });
    </script>
</body>
</html>
