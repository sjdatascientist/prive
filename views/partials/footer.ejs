<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="stylesheet" href="../../css/partials/footer.css" />
	</head>
	<body>
		<footer class="footer-links">
			<div>
				<img src="../assets/Privewhite.svg" alt="" />
			</div>
			<div class="quick-links-div">
				<span>Quick Links</span>
				<ul>
					<li class="explore-cars-link">Explore Cars</li>
					<li class="memberships-link">Memberships</li>
					<li class="book-now-link">Book Now</li>
					<li class="compare-now-link">Compare</li>
					<li class="contact-us-link">Contact Us</li>
					<li class="faqs-link">FAQ's</li>
					<li class="privacy-policy-link">Privacy Policy</li>
				</ul>
			</div>
			<div class="working-time">
				<span>Working Hours</span>
				<p>10AM to 6PM</p>
				<p>MONDAY TO SATURDAY</p>
			</div>
		</footer>
		<div class="reserved-rights">
			<p>2025. All Rights Reserved</p>
		</div>
		<div class="whatsapp-div">
			<img src="../assets/whatsapp.png" class="whatsapp-icon" alt="" />
		</div>

		<script>
			document.getElementsByClassName('explore-cars-link')[0].addEventListener('click', (e) => {
				window.location.href = '/cars'
			})

			document.getElementsByClassName('memberships-link')[0].addEventListener('click', (e) => {
				window.location.href = '/memberships'
			})

			document.getElementsByClassName('book-now-link')[0].addEventListener('click', (e) => {
				window.location.href = '/book'
			})

			document.getElementsByClassName('compare-now-link')[0].addEventListener('click', (e) => {
				window.location.href = '/compare'
			})

			document.getElementsByClassName('contact-us-link')[0].addEventListener('click', (e) => {
				window.location.href = '/contact'
			})

			document.getElementsByClassName('faqs-link')[0].addEventListener('click', (e) => {
				const path = window.location.pathname
				if (path === '/') {
					document.getElementsByClassName('faq-section')[0].scrollIntoView({behavior: 'smooth'})
				} else {
					window.location.href = '/#faq'
				}
			})

			document.getElementsByClassName('privacy-policy-link')[0].addEventListener('click', (e) => {
				window.location.href = '/privacy-policy'
			})

			document.querySelector('.whatsapp-div').addEventListener('click', () => {
				window.location.href = 'https://wa.me/+919606996322' // Replace with your desired link
			})
		</script>
	</body>
</html>
