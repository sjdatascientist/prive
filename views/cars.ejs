<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="../assets/favicon.ico" />
		<title>Explore Cars | Privé Drive</title>
		<link rel="stylesheet" href="../css/cars-style.css" />
		<link rel="stylesheet" href="../css/cars-phone-queries.css" />
	</head>
	<body>
		<%- include('partials/header') %>

		<main class="main-section temp-border">
			<div class="main-section-header temp-border">
				<h3 id="dynamic-header">Explore Vehicles</h3>
				<button class="compare-btn">Compare</button>
			</div>
			<section class="cars-section temp-border">
				<div class="cars-column-div temp-border">
					<!-- <img src="assets/col1.png" alt="" /> -->
					<img src="https://sowbpfqwcnvhxubqvzml.supabase.co/storage/v1/object/public/static-files.public//col1.png" alt="" />
				</div>
				<div class="cars-column-div temp-border">
					<!-- <img src="assets/col1.png" alt="" /> -->
					<img src="https://sowbpfqwcnvhxubqvzml.supabase.co/storage/v1/object/public/static-files.public//col2.png" alt="" />
				</div>
				<div class="cars-column-div temp-border">
					<!-- <img src="assets/col1.png" alt="" /> -->
					<img src="https://sowbpfqwcnvhxubqvzml.supabase.co/storage/v1/object/public/static-files.public//col3.png" alt="" />
				</div>
			</section>
			<section class="cars-mobile-section temp-border">
				<div class="cars-column-mobile-div temp-border">
					<!-- <img src="assets/mobile-col1.svg" alt="" /> -->
					<!-- <object data="https://sowbpfqwcnvhxubqvzml.supabase.co/storage/v1/object/public/static-files.public//mobile-col1.svg" type=""></object> -->
					 <img src="https://sowbpfqwcnvhxubqvzml.supabase.co/storage/v1/object/public/static-files.public//mobile-col1.svg" alt="">
				</div>
				<div class="cars-column-mobile-div temp-border">
					<!-- <img src="assets/mobile-col2.svg" alt="" /> -->
					<img src="https://sowbpfqwcnvhxubqvzml.supabase.co/storage/v1/object/public/static-files.public//mobile-col2.svg" alt="">
				</div>
			</section>
		</main>

		<%- include('partials/footer.ejs') %>

		<script>
			const compareButton = document.getElementsByClassName('compare-btn')[0]
			compareButton.addEventListener('click', function () {
				window.location.href = '/compare'
			})

			function updateText() {
				const headerText = document.getElementById('dynamic-header')
				if (window.innerWidth < 620) {
					headerText.innerText = 'Explore'
				}
				else {
					headerText.innerText = 'Explore Vehicles'
				}
			}

			// Run on load and resize
			window.addEventListener('load', updateText)
			window.addEventListener('resize', updateText)
		</script>
	</body>
</html>
