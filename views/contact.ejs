<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="../assets/favicon.ico" />
		<title>Contact Us | Privé Drive</title>
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
		<link rel="stylesheet" href="../css/contact.css" />
		<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
	</head>
	<body>
		<%- include('partials/header.ejs') %>

		<section class="contact-details-section ref-line">
			<h3>Contact Us</h3>
			<div class="outer-div ref-line">
				<div class="inner-div ref-line">
					<div class="ref-line">
						<img src="../assets/contactLocation.png" alt="" />
						<strong>Address:</strong>
					</div>
					<p>Mantri Residency, Bannerghatta Road, Bangalore 560076</p>
				</div>
				<div class="inner-div ref-line">
					<div class="ref-line">
						<img src="../assets/Email.png" alt="" />
						<strong>Email:</strong>
					</div>
					<p>response@dieselry.com</p>
				</div>
				<div class="inner-div ref-line">
					<div class="ref-line">
						<img src="../assets/Mobile phone.png" alt="" />
						<strong>Mobile No. :</strong>
					</div>
					<p>+91-9606996321</p>
				</div>
			</div>

			<div class="contact-buttons ref-line">
				<button class="whatsapp-button"><i class="fab fa-whatsapp"></i>Chat</button>
				<button class="call-button"><i class="fa-solid fa-phone"></i>Call</button>
				<button class="mail-button"><i class="fa-solid fa-envelope"></i>Email</button>
			</div>
		</section>

		<!-- <section class="map-section">
			<img src="../assets/map.png" alt="" />
		</section> -->

		<section class="contact-us-section">
			<h3>Reach Out To Us</h3>
			<form>
				<input type="text" name="name" id="name" placeholder="Your Name" minlength="3" maxlength="50" required />
				<input type="email" name="email" id="email" placeholder="Enter Your Email" required />
				<input
					type="tel"
					name="phone"
					id="phone"
					placeholder="Phone Number"
					title="'Please Enter 10 Digit Mobile Number"
					minlength="10"
					maxlength="10"
					required />
				<input type="text" name="city" id="city" placeholder="Enter Your City" minlength="3" maxlength="25" required />
				<textarea name="message" id="message" placeholder="Enter Your Message" required></textarea>
				<button type="submit" class="reach-out-btn id="submitBtn">Send Message</button>
			</form>
		</section>

		<div class="thanks-4-contacting">
			<img src="../assets/thankyou.png" alt="">
		</div>

		<%- include('partials/footer.ejs') %>

		<script>
			document.querySelector('.whatsapp-button').addEventListener('click', () => {
				window.location.href = 'https://wa.me/+919606996321'
			})

			document.querySelector('.call-button').addEventListener('click', () => {
				window.location.href = 'tel:+919606996321'
			})

			document.querySelector('.mail-button').addEventListener('click', () => {
				window.location.href = 'mailto:response@dieselry.com'
			})
		</script>
		<script src="../js/reachOut.js"></script>
	</body>
</html>
