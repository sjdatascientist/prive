<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="../assets/favicon.ico">
		<title>Payment | Prive Drive</title>
		<link rel="stylesheet" href="../css/payment.css" />
	</head>
	<body>
		<%- include('partials/header.ejs') %>

        <section class="profile-card">
            <h3>Profile Card</h3>
			<div class="user-info-div ref-line">
				<div class="main-user-info ref-line">
					<strong><%= name %></strong><br>
					<strong><%= email %></strong>
					<p>+91-<%= phone %></p>
					<p><%= city %></p>
					<p><%= car %> (<%= fuel %>)</p>
					<p><%= tickets %> Memberships <strong>(i.e. Rs <%= tickets*10000 %>)</strong></p>
				</div>
			</div>
        </section>

        <button id="fake-payment">Make Payment</button>
		<div id="payment-complete-div">
			<img src="../assets/payment-complete.png" alt="">
		</div>
        <button id="btn-to-bookdates">Go To Book Dates</button>

        <%- include('partials/footer.ejs') %>
    
        <script>
            document.getElementById("btn-to-bookdates").addEventListener('click', () =>window.location.href = '/bookdates')

			const fakePaymentBtn = document.getElementById('fake-payment')
			const paymentDiv = document.getElementById('payment-complete-div')
			const bookDatesBtn = document.getElementById('btn-to-bookdates')

			paymentDiv.style.display = 'none'
			bookDatesBtn.style.display = 'none'

			fakePaymentBtn.addEventListener('click',() => {
				fakePaymentBtn.style.display = 'none'
				paymentDiv.style.display = 'block'
				bookDatesBtn.style.display = 'block'
			})



        </script>

	</body>
</html>
