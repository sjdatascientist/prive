<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="../assets/favicon.ico">
		<title>Payment | Privé Drive</title>
		<link rel="stylesheet" href="../css/payment.css" />
		<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
		<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
	</head>
	<body>
		<%- include('partials/header.ejs') %>

        <section class="profile-card">
            <h3>Profile Card</h3>
			<div class="user-info-div ref-line">
				<div class="main-user-info ref-line">
					<% const {name, email, phone, city, car, tickets, fuel} = userData; %>
					<strong><%= name %></strong><br>
					<strong><%= email %></strong>
					<p>+91-<%= phone %></p>
					<p><%= city %></p>
					<p><%= car %> (<%= fuel %>)</p>
					<p><%= tickets %> Memberships <strong>(i.e. Rs <%= tickets*10000 %>)</strong></p>
				</div>
				<div class="hidden-details">
					<% const details = Object.keys(userData) %>
					<% details.forEach((detail) => { %>
					<p id="<%= detail %>"><%= userData[detail] %></p>
					<% }); %>
				</div>

			</div>
        </section>

        <button id="paymentBtn">Make Payment</button>
		<div id="payment-complete-div">
			<img src="../assets/payment-complete.png" alt="">
			<p>Redirecting to Booking Dates Page in few seconds...<br>
			(Don't Close the Page!)</p>
		</div>
        <button id="btn-to-bookdates">Go To Book Dates</button>

        <%- include('partials/footer.ejs') %>
    
        <script src="../js/payment.js"></script>

	</body>
</html>
