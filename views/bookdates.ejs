<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="../assets/favicon.ico">
		<title>Booking Dates | Privé Drive</title>
		<link rel="stylesheet" href="../css/bookdates.css" />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
        <link rel="stylesheet" type="text/css" href="https://npmcdn.com/flatpickr/dist/themes/dark.css">
		<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
	</head>
	<body>
		<%- include('partials/header.ejs') %>

        <section class="calender-section ref-line">
            <h3>Book Dates</h3>
			<form action="" class="ref-line">
				<input id="flatpickr-calender" type="datetime-local" placeholder="Select Booking Dates Range" />
			</form>
			<div class="legend ref-line">
				<div class="ref-line">
					<div id="one"></div>
					<strong>Not Available</strong>
				</div>
				<div class="ref-line">
					<div id="two"></div>
					<strong>Available</strong>
				</div>
				<div class="ref-line">
					<div id="three"></div>
					<strong>Reserved by You</strong>
				</div>
			</div>
			<!-- Dynamic Table -->
			<div class="selected-dates-div">
				<h4>The Selected Booking Dates Are ⬇️</h4>
				<table>
					<tr>
						<th>Date</th>
						<th>Day</th>
					</tr>
					<!-- Dynamic Row Inserting -->
				</table>
			</div>
			<em></em>
			<p class="ref-line"><strong>&#9888; Note: </strong>For <i>Saturday, Sunday, and Public Holidays</i> the charges will be <strong>twice </strong>than regular days!<br>
			You are allowed to book only <strong>maximum of 10 days</strong> for a single booking.</p>
			
			<button id="reserve-btn" disabled>Reserve Now</button>
        </section>
		

		<%- include('partials/footer.ejs') %>

		<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
		<script src="../js/flatpickr-calender.js"></script>
	</body>
</html>
