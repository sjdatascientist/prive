<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Book Now</title>
		<link rel="stylesheet" href="../css/bookdates.css" />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
        <link rel="stylesheet" type="text/css" href="https://npmcdn.com/flatpickr/dist/themes/dark.css">
	</head>
	<body>
		<%- include('partials/header.ejs') %>

        <section class="calender-section ref-line">
            <h3>Book Dates</h3>
			<form action="" class="ref-line">
				<input id="flatpickr-calender" type="datetime-local" placeholder="Select Booking Dates Range" />
			</form>
			<div class="legend ref-line">
				<div class="ref-line">
					<div id="one"></div>
					<strong>Not Available</strong>
				</div>
				<div class="ref-line">
					<div id="two"></div>
					<strong>Available</strong>
				</div>
				<div class="ref-line">
					<div id="three"></div>
					<strong>Reserved by You</strong>
				</div>
			</div>
			<em></em>
			<p class="ref-line"><strong>&#9888; Note: </strong>For <i>Saturday, Sunday, and Public Holidays</i> the charges will be <strong>twice </strong>than regular days!</p>
			
			<button>Reserve Now</button>
        </section>
		

		<%- include('partials/footer.ejs') %>

		<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
		<script src="../js/flatpickr-calender.js"></script>
	</body>
</html>
