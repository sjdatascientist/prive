<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="../assets/favicon.ico">
		<title>Book Now | Privé Drive</title>
		<link rel="stylesheet" href="../css/book.css" />
		<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
		
	</head>
	<body>
		<%- include('partials/header.ejs') %>

		<section class="ref-line">
			<h3>Enter Your Details</h3>
			<div class="form-div ref-line">
				<form action="/payment" method="POST" id="UserDetailsForm">
					<div class="ref-line">
						<label for="name">Name</label>
						<input type="text" name="name" id="name" maxlength="50"/>
						<p class="error-message" id="nameError">Name must be at least 3 characters long</p>
					</div>
					<div class="ref-line">
						<label for="email">Email</label>
						<input type="email" name="email" id="email" maxlength="40"/>
						<p class="error-message" id="emailError">Please enter a valid email address</p>
					</div>
					<div class="ref-line">
						<label for="phone">Phone</label>
						<input type="tel" name="phone" id="phone" maxlength="10"/>
						<p class="error-message" id="phoneError">Please enter a valid 10-digit phone number</p>
					</div>
					<div class="ref-line">
						<label for="city">City</label>
						<select name="city" id="city">
							<option value="" selected disabled hidden>Select</option>
							<option value="Banglore">Bangalore</option>
							<option value="New Delhi">New Delhi</option>
							<option value="Mumbai">Mumbai</option>
							<option value="Chennai">Chennai</option>
							<option value="Hyderabad">Hyderabad</option>
							<option value="Pune">Pune</option>
							<option value="Lucknow">Lucknow</option>
							<option value="Kanpur">Kanpur</option>
							<option value="Dehradun">Dehradun</option>
							<option value="Mysore">Mysore</option>
							<option value="Mangalore">Mangalore</option>
							<option value="Ahmedabad">Ahmedabad</option>
							<option value="Kolkata">Kolkata</option>
							<option value="Cochin">Cochin</option>
							<option value="Trivandrum">Trivandrum</option>
							<option value="Surat">Surat</option>
							<option value="Vishakapatnam">Vishakapatnam</option>
							<option value="Jaipur">Jaipur</option>
							<option value="Nagpur">Nagpur</option>
							<option value="Indore">Indore</option>
							<option value="Bhopal">Bhopal</option>
							<option value="Ludhiana">Ludhiana</option>
							<option value="Vadodra">Vadodra</option>
						</select>
						<p class="error-message" id="cityError">city be at least 3 characters long</p>
					</div>
					<div class="ref-line">
						<label for="car">Car Model</label>
						<select name="car" id="car">
							<option value="" selected disabled hidden>Select</option>
							<% const carsList = Object.keys(cars) %>
							<% carsList.forEach((car) => { %>
							<option value="<%= car %>"><%= car %></option>
							<% }); %>
						</select>
					</div>
					<div class="ref-line">
						<label for="tickets">Number of Memberships</label>
						<select name="tickets" id="tickets">
							<option value="" selected disabled hidden>Select</option>
							<option value="1">1</option>
							<option value="2">2</option>
							<option value="3">3</option>
						</select>
					</div>
					<div class="ref-line">
						<label for="fuel">Fuel Type</label>
						<select name="fuel" id="fuel">
							<option value="" selected disabled hidden>Select</option>
							<option value="Petrol">Petrol</option>
							<option value="Diesel">Diesel</option>
						</select>
					</div>
					<div class="ref-line">
						<label for="">Per Membership Ownership</label>
						<p>9.33% ownership of the car</p>
					</div>
					<div class="ref-line">
						<label for="">Per Membership Price</label>
						<p>Rs 10,000 (one time payment)</p>
					</div>
					<div class="ref-line">
						<label for="">Usage Per Membership</label>
						<p>45 Days/Year</p>
					</div>
					<div class="ref-line">
						<label for="">Service Term</label>
						<p>5 Years</p>
					</div>
				</form>
				<div class="button-block">
					<button type="submit" form="UserDetailsForm" id="submitBtn" disabled>Proceed to Payment</button>
					<i id="requiredNote">(*All fields are required)</i>
				</div>
				<p class="note ref-line"><strong>&#9888; Note: </strong>Each plan costs Rs 10,000 and will be adjusted in membership cost.</p>
			</div>
		</section>

		<%- include('partials/footer.ejs') %>

		<script src="../js/book.js" type="module"></script>

	</body>
</html>
