<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Book Now</title>
		<link rel="stylesheet" href="../css/book.css" />
	</head>
	<body>
		<%- include('partials/header.ejs') %>

		<section class="book-section ref-line">
			<h3>Book Now</h3>
			<div class="user-info-div ref-line">
				<div class="main-user-info ref-line">
					<strong>John Doe</strong><br>
					<strong>1234567890</strong>
					<p>johndoe@email.com</p>
				</div>
				<div class="location-info ref-line">
					<!-- <img src="" alt=""> -->
					<p>Location</p>
				</div>
			</div>
			<div class="form-div ref-line">
				<form action="">
					<div class="ref-line">
						<label for="">Color</label>
						<select name="" id=""></select>
							<option value="" selected disabled hidden>Select</option>
					</div>
					<div class="ref-line">
						<label for="">Fuel Type</label>
						<select name="" id=""></select>
							<option value="" selected disabled hidden>Select</option>
					</div>
					<div class="ref-line">
						<label for="">Variant</label>
						<select name="" id=""></select>
							<option value="" selected disabled hidden>Select</option>
					</div>
					<div class="ref-line">
						<label for="">Select Number of Tickets</label>
						<select name="" id=""></select>
							<option value="" selected disabled hidden>Select</option>
					</div>
					<div class="ref-line">
						<label for="">2 Tickets</label>
						<p>18.66% ownership of the car</p>
					</div>
					<div class="ref-line">
						<label for="">Ticket Price</label>
						<p>Rs 8.88 Lakhs (one time payment)</p>
					</div>
					<div class="ref-line">
						<label for="">Usage</label>
						<p>45 Days/Year</p>
					</div>
					<div class="ref-line">
						<label for="">Service Term</label>
						<p>5 Years</p>
					</div>
					<button>Proceed to Payment</button>
				</form>
			</div>
		</section>

		<%- include('partials/footer.ejs') %>

	</body>
</html>
