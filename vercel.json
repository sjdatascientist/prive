{
	"version": 2,
	"builds": [
		{
			"src": "./app.js",
			"use": "@vercel/node"
		}
	],
	"routes": [
		{
			"src": "/(.*)",
			"dest": "/app.js",
			"methods": ["GET", "POST", "PATCH", "OPTIONS"]
		}
	],
  
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "Access-Control-Allow-Origin",
					"value": "https://prive-ten.vercel.app"
				},
				{
					"key": "Access-Control-Allow-Methods",
					"value": "GET,POST,PATCH,OPTIONS"
				},
				{
					"key": "Access-Control-Allow-Headers",
					"value": "X-Requested-With, Content-Type, Authorization, Razorpay-Signature"
				},
				{
					"key": "Access-Control-Allow-Credentials",
					"value": "true"
				}
			]
		}
	]
}
